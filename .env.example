# Crea el bot en https://discord.com/developers/applications y copia su token.
DISCORD_TOKEN=pega_aqui_el_token_del_bot

# Opcional: durante el desarrollo, sincroniza los comandos al instante en
# este servidor. Activa el modo desarrollador de Discord para copiar su ID.
DISCORD_GUILD_ID=

# Opcionales
COMMAND_PREFIX=!
DEFAULT_VOLUME=0.5
IDLE_TIMEOUT_SECONDS=300
MAX_PLAYLIST_ITEMS=50
FFMPEG_EXECUTABLE=ffmpeg

